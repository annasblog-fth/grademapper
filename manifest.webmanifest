{
  "name": "Little Grades",
  "short_name": "Little Grades",
  "description": "A cute, simple grade tracker that tells you what you need on your next test.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FBF7E8",
